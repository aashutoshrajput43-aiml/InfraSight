# ==========================================
# InfraSight Environment Configuration
# ==========================================

# --- Backend Database (PostGIS or SQLite fallback) ---
# For PostgreSQL with PostGIS (Supabase):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infrasight
# For local zero-config SQLite fallback:
DATABASE_URL=sqlite:///./infrasight.db

# --- Supabase Integration ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- AI & Vision LLM Settings ---
# Set MOCK_AI=true to run without GPU or API keys
MOCK_AI=true
LLM_PROVIDER=gemini
# Options: 'gemini' or 'claude'
LLM_API_KEY=your-gemini-or-claude-api-key
LLM_MODEL=gemini-1.5-flash

# --- Overpass API (OSM Indore Context) ---
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Complaints & Email Routing ---
RESEND_API_KEY=re_your_resend_api_key
COMPLAINT_FROM_EMAIL=complaints@infrasight.indore.gov.in
COMPLAINT_TO_EMAIL=imc-road-works-test@indore.nic.in

# SMTP Fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# --- Server & CORS ---
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend Variables (Vite) ---
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
